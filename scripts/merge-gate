#!/usr/bin/env bash
# heinzelwerk auto-merge gate. Deterministic: decides from the PR + policy, nothing else. Off unless enabled.
# Usage: merge-gate [-C <repo dir>] [<owner/repo>#]<pr-number>   (run inside the repo, or name it with -C first; with
#        owner/repo the gate checks that the dir is that repo; prints MERGED or MERGE SKIP: <reasons>, a usage error
#        included; exit 0 either way; a PR already merged into main prints MERGED … (already merged by <login>), a
#        closed one MERGE SKIP: PR closed)
# Lives in the plugin's scripts/, so no PR can change it. Policy: docs/agents/heinzelwerk/merge-policy.json as on main
# on GitHub, never the branch's copy. A PR that touches a heinzelwerk policy file, the project's Claude Code settings,
# or a workflow always waits for a human. A PR stacked on another PR's branch is retargeted to main once that PR merged.
# A PR whose body says `Depends on <PR>[, <PR> and <PR>]` (`owner/repo#N`, `#N`, or a pull URL) waits until every such PR
# is merged.
# Waits up to MERGE_GATE_WAIT seconds (default 450) for CI and, when the policy names a `review_bot`, for its review of the
# head sha (`review-gate`, same budget): run it with a ten-minute Bash timeout. `bot_review: required` → an open, pending, or
# unavailable bot review is a skip reason; `best-effort` → open threads skip, pending or unavailable merge with a note line.
# The newest validator verdict of the head (a body with a stand-alone `heinzelwerk: validated <sha>` line naming it) may hold `inconclusive: main only: <check>; …`
# lines (a CI job that runs on main only): each needs tech-lead's line `heinzelwerk: accepted main-only <check> @ <sha>`
# naming the head, like the validated line.
# Needs: gh only (its built-in --jq). Globs: bash patterns on the repo-relative path; * also matches /.
set -euo pipefail
# a gh or network failure still ends in a verdict line (no -E: an inherited trap inside $(...) would swallow the error)
trap 'echo "MERGE SKIP: gate error (line $LINENO)"; exit 0' ERR
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)   # before any cd: review-gate sits next to this script
usage() { echo "MERGE SKIP: usage: merge-gate [-C <repo dir>] [<owner/repo>#]<pr-number>"; exit 0; }
# -C <repo dir>: gate a PR of that repo from anywhere (workspace mode runs from the workspace root)
if [ "${1:-}" = -C ]; then
  [ $# -ge 2 ] && [ -n "$2" ] || usage
  CDPATH='' cd -- "$2" 2>/dev/null || { echo "MERGE SKIP: no repo dir $2"; exit 0; }; shift 2
fi
[ $# -eq 1 ] || usage
want=""
if [[ $1 =~ ^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$ ]]; then want=${BASH_REMATCH[1]}; pr=${BASH_REMATCH[2]}
elif [[ $1 =~ ^[0-9]+$ ]]; then pr=$1
else usage; fi
if [ -n "$want" ]; then
  # a wrong -C with a matching PR number would gate another repo's PR
  is=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || { echo "MERGE SKIP: $(pwd) is no GitHub repo (wanted $want)"; exit 0; }
  [ "$(tr '[:upper:]' '[:lower:]' <<<"$is")" = "$(tr '[:upper:]' '[:lower:]' <<<"$want")" ] || { echo "MERGE SKIP: $(pwd) is $is, not $want"; exit 0; }
fi
raw() { gh api -H 'Accept: application/vnd.github.raw+json' "repos/{owner}/{repo}/contents/$1?ref=main" "${@:2}"; }
pol() { raw docs/agents/heinzelwerk/merge-policy.json --jq "$1"; }
pv() { gh pr view "$pr" --json "$1" --jq "$2"; }
# a check run's conclusion is "" until it completes, so branch on status; a commit status carries state directly
checks() { pv statusCheckRollup '.statusCheckRollup[]? | if .__typename == "CheckRun" then (if .status == "COMPLETED" then .conclusion else "PENDING" end) else (.state // "PENDING") end'; }
# the bot-review verdict comes from the sibling script review-gate (plugin scripts/, so no PR can change it)
bot_review_verdict() { "$here/review-gate" "$pr" | head -1; }   # e.g. "BOT REVIEW: clean <sha>"
bot_review_pending() { bot_review_verdict | grep -q "^BOT REVIEW: pending"; }
# a rerun of the merge task meets PRs an earlier round merged: done, not a skip, but only once on main; the merger is named
# so a human's merge reads as one. A closed PR is never touched (the retarget below would reopen it)
state=$(pv state .state)
if [ "$state" = MERGED ]; then
  mbase=$(pv baseRefName .baseRefName); by=$(pv mergedBy '.mergedBy.login // "unknown"')
  [ "$mbase" = main ] || { echo "MERGE SKIP: merged into $mbase, not main (by $by)"; exit 0; }
  echo "MERGED: PR $pr (already merged by $by)"; exit 0
fi
[ "$state" = CLOSED ] && { echo "MERGE SKIP: PR closed"; exit 0; }
enabled=$(pol '.enabled // false' 2>/dev/null) || { echo "MERGE SKIP: no docs/agents/heinzelwerk/merge-policy.json on main"; exit 0; }
[ "$enabled" = true ] || { echo "MERGE SKIP: auto-merge off"; exit 0; }

# stacked on another PR's branch: once that PR is merged, retarget to main (GitHub recomputes diff and mergeability)
base=$(pv baseRefName .baseRefName)
if [ "$base" != main ]; then
  bstate=$(gh pr view "$base" --json state --jq .state 2>/dev/null || echo none)
  if [ "$bstate" = MERGED ]; then
    gh pr edit "$pr" --base main >/dev/null; sleep 5
    # a base change fires no pull_request run on a default-typed workflow; close+reopen does (same head, validated line stays)
    gh pr close "$pr" >/dev/null && gh pr reopen "$pr" >/dev/null; sleep 10
  else echo "MERGE SKIP: base $base is not main (its PR: $bstate)"; exit 0; fi
fi

# let CI finish; the verdict reads the final state
wait=${MERGE_GATE_WAIT:-450}; deadline=$(( SECONDS + wait ))
while { grep -qE '^(PENDING|EXPECTED)$' <<<"$(checks)" || bot_review_pending; } && (( SECONDS < deadline )); do sleep 15; done
reasons=()
[ "$(pv state .state)" = OPEN ] || reasons+=("PR not open")
[ "$(pv isDraft .isDraft)" = false ] || reasons+=("draft")
# GitHub recomputes mergeability after every merge to main; UNKNOWN means it is still at it
m=$(pv mergeable .mergeable); for _ in 1 2 3 4 5 6; do [ "$m" = UNKNOWN ] || break; sleep 5; m=$(pv mergeable .mergeable); done
[ "$m" = MERGEABLE ] || reasons+=("mergeable: $m (needs a rebase)")
bodies=$(pv comments,reviews '.comments[].body, .reviews[].body'); bodies=${bodies//$'\r'/}
head=$(pv headRefOid .headRefOid)
# a marker names the head: the full sha, or a prefix of 7+ hex chars that matches it
names_head() { [[ ${#1} -ge 7 && $head == "$1"* ]]; }
# the validator's pass must name the commit being merged; a push after validation needs a new pass. Only a line that is
# the marker and nothing else counts: a posted skip reason quoting it is no pass
if [ "$(pol '.require_validation // true')" = true ]; then
  vok=no
  for v in $(grep -E '^heinzelwerk: validated [0-9a-f]{7,40}[[:space:]]*$' <<<"$bodies" | awk '{print $3}' || true); do
    names_head "$v" && vok=yes
  done
  [ $vok = yes ] || reasons+=("no \"heinzelwerk: validated $head\" on the PR")
fi
# a check validator could not see (its job runs on main only) merges only with tech-lead's acceptance of this head.
# The checks come from the newest verdict of this head alone: a body with a stand-alone validated line naming the head
# (the same rule as above, so a footer below the line changes nothing); a comment quoting the form demands nothing.
# Names are plain strings. $head is hex from gh, safe inside the jq string
verdict=$(pv comments,reviews '[(.comments[] | {t: .createdAt, b: .body}), (.reviews[] | {t: .submittedAt, b: .body})] | map(select([(.b // "") | scan("(?m)^heinzelwerk: validated ([0-9a-f]{7,40})[ \t\r]*$") | .[0]] | any(. as $s | "'"$head"'" | startswith($s)))) | sort_by(.t) | (last // {b: ""}) | .b')
verdict=${verdict//$'\r'/}
accepted=$(grep -E '^heinzelwerk: accepted main-only .+ @ [0-9a-f]{7,40}[[:space:]]*$' <<<"$bodies" | sed -E 's/^heinzelwerk: accepted main-only //; s/[[:space:]]+$//' || true)
while IFS= read -r c; do
  [ -n "$c" ] || continue; aok=no
  while IFS= read -r a; do
    [[ -n $a && ${a% @ *} == "$c" ]] && names_head "${a##* @ }" && aok=yes
  done <<<"$accepted"
  [ $aok = yes ] || reasons+=("main-only check $c not accepted for this head (needs \"heinzelwerk: accepted main-only $c @ $head\", tech-lead)")
done < <(grep -oiE 'inconclusive: main[ -]only: [^;]+' <<<"$verdict" | sed -E 's/^[^:]*: [^:]*:[[:space:]]*//; s/[[:space:]]+$//' | sort -u || true)
body=$(pv body '.body'); body=${body//$'\r'/}
grep -qE '^[[:space:]]*[-*] \[ \]' <<<"$body" && reasons+=("unchecked item in PR body (needs a human)")
# Depends on: every named PR merged first (a cross-repo consumer never lands before its provider). Only the refs right
# after the phrase count (`Depends on a/b#1, c/d#2 and #3`), so `Closes …#140` or "depends on the config" add nothing
ref='(https://github\.com/)?[A-Za-z0-9-]+/[A-Za-z0-9_.-]+(#|/pull/)[0-9]+|#[0-9]+'
deps=$(grep -oiE "depends on:?[[:space:]]+($ref)([[:space:]]*(,|and|&)[[:space:]]*($ref))*" <<<"$body" | grep -oE "$ref" \
  | sed -E 's#^https://github\.com/##; s#/pull/#\##' | sort -u || true)
while IFS= read -r d; do
  [ -n "$d" ] && [ "$d" != "#$pr" ] || continue
  if [[ $d == \#* ]]; then ds=$(gh pr view "${d#\#}" --json state --jq .state 2>/dev/null || echo "no readable PR (an issue, or no access)")
  else ds=$(gh pr view "${d##*#}" -R "${d%#*}" --json state --jq .state 2>/dev/null || echo "no readable PR (an issue, or no access)"); fi
  [ "$ds" = MERGED ] || reasons+=("depends on $d, which is $ds (merge it first)")
done <<<"$deps"
# optional size cap: only when the policy sets max_changed_lines
max=$(pol '.max_changed_lines // empty')
if [[ -n $max && $max =~ ^[0-9]+$ ]]; then
  n=$(pv additions,deletions '.additions + .deletions'); (( n <= max )) || reasons+=("$n changed lines > max_changed_lines $max")
elif [ -n "$max" ]; then reasons+=("max_changed_lines is not a number: $max"); fi
# every file must match allow_paths and no deny_paths; policy, settings, and workflows always need a human
allow=$(pol '.allow_paths[]?'); deny=$(pol '.deny_paths[]?'); files=$(pv files '.files[].path')
[ -n "$files" ] || reasons+=("no changed files read")
(( $(wc -l <<<"$files") < 100 )) || reasons+=("100 or more changed files (gh lists at most 100, so the check is partial)")
while IFS= read -r f; do
  [ -n "$f" ] || continue; ok=no
  while IFS= read -r g; do [[ -n $g && $f == $g ]] && ok=yes; done <<<"$allow"
  while IFS= read -r g; do [[ -n $g && $f == $g ]] && ok=no; done <<<"$deny"
  [[ $f == docs/agents/heinzelwerk/*-policy.json || $f == .claude/settings*.json || $f == .github/workflows/* ]] && ok=no
  [ $ok = yes ] || reasons+=("path not allowed: $f")
done <<<"$files"
# CI: every check passed; none at all only if the policy doesn't require checks
results=$(checks)
if [ -z "$results" ]; then
  [ "$(pol '.require_checks // true')" = false ] || reasons+=("no CI checks on the PR")
else
  pending=$(grep -cE '^(PENDING|EXPECTED)$' <<<"$results" || true)
  (( pending == 0 )) || reasons+=("$pending CI check(s) still running after ${wait}s")
  bad=$(grep -cvE '^(SUCCESS|NEUTRAL|SKIPPED|PENDING|EXPECTED)$' <<<"$results" || true)
  (( bad == 0 )) || reasons+=("$bad CI check(s) failed")
fi

# bot review: what a non-clean verdict means is the policy's `bot_review` (best-effort or required)
merge_note=""
bot_verdict=$(bot_review_verdict); bot_verdict=${bot_verdict#BOT REVIEW: }   # off | clean <sha> | open <n> | pending | unavailable: <why>
case $bot_verdict in
  off | clean*) ;;
  open*)        reasons+=("bot review: $bot_verdict unresolved thread(s) (reply and fix; the bot resolves)") ;;
  *)            if [ "$(pol '.bot_review // "off"')" = required ]; then
                  reasons+=("bot review $bot_verdict")
                else
                  merge_note="bot review $bot_verdict (best-effort: merged without it)"
                fi ;;
esac

if (( ${#reasons[@]} )); then echo "MERGE SKIP:"; printf '  - %s\n' "${reasons[@]}"; exit 0; fi
if out=$(gh pr merge "$pr" "--$(pol '.merge_method // "squash"')" 2>&1); then echo "MERGED: PR $pr"; [ -z "$merge_note" ] || echo "  - note: $merge_note"
else echo "MERGE SKIP:"; echo "  - merge failed: ${out//$'\n'/ }"; fi
