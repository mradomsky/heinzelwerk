#!/usr/bin/env bash
# heinzelwerk spawn context. Deterministic: prints the context block a teammate's spawn prompt carries, so the
# teammate's first turn already holds what it would otherwise fetch (the ticket, the plan comment, team rules,
# the agent-skills pointers; validator: the PR). Coordinator runs it once per spawn and pastes the output under
# `## Context`. Any fetch that fails exits non-zero, so a half block is never pasted. Needs only gh and git.
# Usage: spawn-context <role> <ticket-number> [--pr N] [--tickets owner/repo] [--dir <repo dir>]
#   --tickets  the repo that holds the ticket (workspace mode); default: the repo in --dir
#   --dir      the repo whose team.md and CLAUDE.md are read; default: cwd
# Size caps: ticket body 200 lines, each comment 80 lines, PR body 120 lines, changed files 80 lines.
set -uo pipefail
role=${1:-}; ticket=${2:-}; shift 2 || true
pr=""; tickets=""; dir="."
while [ $# -gt 0 ]; do
  case $1 in
    --pr) pr=$2; shift 2 ;;
    --tickets) tickets=$2; shift 2 ;;
    --dir) dir=$2; shift 2 ;;
    *) echo "spawn-context: unknown argument $1" >&2; exit 1 ;;
  esac
done
[ -n "$role" ] && [[ $ticket =~ ^[0-9]+$ ]] || { echo "usage: spawn-context <role> <ticket-number> [--pr N] [--tickets owner/repo] [--dir repo]" >&2; exit 1; }
cd "$dir" || exit 1
repo=$(gh repo view --json nameWithOwner -q .nameWithOwner) || { echo "spawn-context: gh repo view failed in $PWD" >&2; exit 1; }
[ -n "$tickets" ] || tickets=$repo
cap() { awk -v n="$1" 'NR<=n{print} NR==n+1{print "… (cut at " n " lines)"}'; }
section() { printf '\n### %s\n' "$1"; }
fail() { echo "spawn-context: $*" >&2; exit 1; }

printf '## Context (spawn-context, %s)\nrole: %s · ticket: %s#%s · repo: %s\n' "$(date -u +'%Y-%m-%d %H:%M UTC')" "$role" "$tickets" "$ticket" "$repo"

# ticket
head=$(gh issue view "$ticket" -R "$tickets" --json title,url,labels -q '.title + "\n" + .url + "\nlabels: " + ([.labels[].name] | join(", "))') || fail "gh issue view $tickets#$ticket failed"
section "Ticket: $(sed -n 1p <<<"$head")"
sed -n '2,3p' <<<"$head"; echo
gh issue view "$ticket" -R "$tickets" --json body -q .body | cap 200

# the newest plan comment and run-state comment, by their fixed headings
api="repos/$tickets/issues/$ticket/comments?per_page=100"
plan=$(gh api "$api" --paginate -q '[.[] | select(.body | test("(^|\n)Decisions\n") and test("\nTasks\n"))] | last // empty | .html_url + "\n" + .body') || fail "comments fetch failed"
if [ -n "$plan" ]; then section "Plan comment (tech-lead)"; printf '%s\n' "$plan" | cap 80; fi
state=$(gh api "$api" --paginate -q '[.[] | select(.body | startswith("## Heinzelwerk run state"))] | last // empty | .html_url + "\n" + .body') || fail "comments fetch failed"
if [ -n "$state" ]; then section "Run state (an earlier run on this ticket)"; printf '%s\n' "$state" | cap 80; fi

# team rules: the entries every role reads before coding or validating, with their indented continuation lines
team=docs/agents/heinzelwerk/team.md
[ -f "$team" ] || fail "$team not found; run setup first"
section "Team rules ($team, these entries; read the file for the rest)"
awk '/^- \*\*(Autonomy|Backend paths|Frontend paths|Infra paths|Shared paths|Worktree setup|Checks|Coding standards|Run cap|Silence)\*\*/{p=1; print; next} /^- \*\*/{p=0} p && /^[[:space:]]+/{print; next} p && !/^[[:space:]]*$/{p=0}' "$team"

# the agent-skills pointer block: where the docs live
if [ -f CLAUDE.md ]; then
  section "Agent skills pointers (CLAUDE.md)"
  awk '/^## Agent skills \(heinzelwerk\)/{p=1; next} /^## /{p=0} p' CLAUDE.md
fi

# validator: the PR under review
if [ -n "$pr" ]; then
  ph=$(gh pr view "$pr" -R "$repo" --json title,url,headRefName,headRefOid,baseRefName -q '.title + "\n" + .url + "\nhead: " + .headRefName + " @ " + .headRefOid + " · base: " + .baseRefName') || fail "gh pr view $pr failed"
  section "PR #$pr: $(sed -n 1p <<<"$ph")"
  sed -n '2,3p' <<<"$ph"; echo
  gh pr view "$pr" -R "$repo" --json body -q .body | cap 120
  section "Changed files"
  gh pr view "$pr" -R "$repo" --json files -q '.files[] | "\(.additions)+ \(.deletions)- \(.path)"' | cap 80 || fail "gh pr view files failed"
elif [ "$role" = validator ]; then
  fail "validator needs --pr <number>"
fi
