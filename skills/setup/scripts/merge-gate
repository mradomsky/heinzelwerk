#!/usr/bin/env bash
# heinzelwerk auto-merge gate. Deterministic: decides from the PR + policy, nothing else. Off unless enabled.
# Usage: scripts/merge-gate <pr-number>   (run inside the repo; prints MERGED or MERGE SKIP: <reasons>; exit 0 either way)
# Policy: docs/agents/heinzelwerk/merge-policy.json as on main on GitHub, never the branch's copy. The script
# refuses to run unless it is identical to main's copy, and never merges a PR that touches the gate or its policy.
# Waits up to MERGE_GATE_WAIT seconds (default 540) for CI: run it with a ten-minute Bash timeout.
# Needs: gh only (its built-in --jq). Globs: bash patterns on the repo-relative path; * also matches /.
set -euo pipefail
pr=${1:?pr number}
raw() { gh api -H 'Accept: application/vnd.github.raw+json' "repos/{owner}/{repo}/contents/$1?ref=main" "${@:2}"; }
pol() { raw docs/agents/heinzelwerk/merge-policy.json --jq "$1"; }
pv() { gh pr view "$pr" --json "$1" --jq "$2"; }
checks() { pv statusCheckRollup '.statusCheckRollup[]? | (.conclusion // .state // "PENDING")'; }
cr=$'\r'
main_gate=$(raw scripts/merge-gate 2>/dev/null) || main_gate=""
[ -n "$main_gate" ] && [ "${main_gate//$cr/}" = "$(tr -d "$cr" <"$0")" ] \
  || { echo "MERGE SKIP: this merge-gate differs from main's copy"; exit 0; }
enabled=$(pol '.enabled // false' 2>/dev/null) || { echo "MERGE SKIP: no docs/agents/heinzelwerk/merge-policy.json on main"; exit 0; }
[ "$enabled" = true ] || { echo "MERGE SKIP: auto-merge off"; exit 0; }

# let CI finish; the verdict reads the final state
wait=${MERGE_GATE_WAIT:-540}; deadline=$(( SECONDS + wait ))
while grep -qE '^(PENDING|EXPECTED)$' <<<"$(checks)" && (( SECONDS < deadline )); do sleep 15; done
reasons=()
[ "$(pv state .state)" = OPEN ] || reasons+=("PR not open")
[ "$(pv isDraft .isDraft)" = false ] || reasons+=("draft")
[ "$(pv baseRefName .baseRefName)" = main ] || reasons+=("base is not main")
# GitHub recomputes mergeability after every merge to main; UNKNOWN means it is still at it
m=$(pv mergeable .mergeable); for _ in 1 2 3 4 5 6; do [ "$m" = UNKNOWN ] || break; sleep 5; m=$(pv mergeable .mergeable); done
[ "$m" = MERGEABLE ] || reasons+=("mergeable: $m (needs a rebase)")
# the validator's pass must name the commit being merged; a push after validation needs a new pass
if [ "$(pol '.require_validation // true')" = true ]; then
  head=$(pv headRefOid .headRefOid)
  pv comments,reviews '.comments[].body, .reviews[].body' | grep -qF "heinzelwerk: validated $head" \
    || reasons+=("no \"heinzelwerk: validated $head\" on the PR")
fi
pv body '.body' | grep -qE '^[[:space:]]*[-*] \[ \]' && reasons+=("unchecked item in PR body (needs a human)")
n=$(pv additions,deletions '.additions + .deletions'); max=$(pol '.max_changed_lines // 200')
(( n <= max )) || reasons+=("$n changed lines > max_changed_lines $max")
# every file must match allow_paths and no deny_paths; the gate and its policy always need a human
allow=$(pol '.allow_paths[]?'); deny=$(pol '.deny_paths[]?'); files=$(pv files '.files[].path')
[ -n "$files" ] || reasons+=("no changed files read")
(( $(wc -l <<<"$files") < 100 )) || reasons+=("100 or more changed files (gh lists at most 100, so the check is partial)")
while IFS= read -r f; do
  [ -n "$f" ] || continue; ok=no
  while IFS= read -r g; do [[ -n $g && $f == $g ]] && ok=yes; done <<<"$allow"
  while IFS= read -r g; do [[ -n $g && $f == $g ]] && ok=no; done <<<"$deny"
  [[ $f == scripts/merge-gate || $f == docs/agents/heinzelwerk/merge-policy.json ]] && ok=no
  [ $ok = yes ] || reasons+=("path not allowed: $f")
done <<<"$files"
# CI: every check passed; none at all only if the policy doesn't require checks
results=$(checks)
if [ -z "$results" ]; then
  [ "$(pol '.require_checks // true')" = false ] || reasons+=("no CI checks on the PR")
else
  pending=$(grep -cE '^(PENDING|EXPECTED)$' <<<"$results" || true)
  (( pending == 0 )) || reasons+=("$pending CI check(s) still running after ${wait}s")
  bad=$(grep -cvE '^(SUCCESS|NEUTRAL|SKIPPED|PENDING|EXPECTED)$' <<<"$results" || true)
  (( bad == 0 )) || reasons+=("$bad CI check(s) failed")
fi

if (( ${#reasons[@]} )); then echo "MERGE SKIP:"; printf '  - %s\n' "${reasons[@]}"; exit 0; fi
if out=$(gh pr merge "$pr" "--$(pol '.merge_method // "squash"')" 2>&1); then echo "MERGED: PR $pr"
else echo "MERGE SKIP:"; echo "  - merge failed: ${out//$'\n'/ }"; fi
